generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Vercel's Neon marketplace integration prefixes every env var it creates
  // with the storage resource's name (here "STORE_") rather than setting a
  // plain DATABASE_URL — see README for details.
  url      = env("STORE_DATABASE_URL")
}

model Task {
  id               String    @id @default(cuid())
  title            String
  notes            String?
  // Calendar date (day precision) this task is scheduled for.
  // null = no date yet -> bucketed into "Later".
  // Buckets are derived live from this date vs. the current date, so a task
  // scheduled for "tomorrow" lands in "Today" automatically once the day
  // rolls over — no midnight job needed.
  date             DateTime?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  // Manual sort order within whatever bucket the task falls into.
  order            Int       @default(0)
  // Rough duration estimate in minutes, used by the AI time-blocking suggestion.
  estimatedMinutes Int?
  // Once this task lands on the Time Blocks calendar and Google Calendar is
  // connected, it becomes a real event there — this is that event's id, so
  // it's only ever created once instead of duplicated on every page load.
  googleEventId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Single row holding the connected Google account's OAuth tokens. This is a
// personal single-user app, so there's never more than one of these.
model GoogleAccount {
  id           String   @id @default("singleton")
  email        String?
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  // The app writes every block (task and preference) to this dedicated
  // calendar rather than the user's main one, so it never clutters their
  // real calendar. It still *reads* the main calendar to know what's busy.
  // Created automatically on first sync; null until then. Tracked by id, so
  // the user is free to rename the calendar in Google Calendar afterward
  // without breaking anything.
  calendarId   String?
  calendarName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Single row of app-wide settings. Personal single-user app, so there's
// never more than one of these either.
model Settings {
  id              String   @id @default("singleton")
  // Minutes since midnight. The scheduler never places a flexible task
  // outside this window.
  workStartMinute Int      @default(540) // 9:00
  workEndMinute   Int      @default(1080) // 18:00
  updatedAt       DateTime @updatedAt
}

model Preference {
  id String @id @default(cuid())
  // Free-text bullet, e.g. "prefer deep work in the morning" or "exercise".
  // Always shown to the AI scheduler as context/reasoning input.
  text String
  // When locked, this becomes a hard block on the calendar (like a real
  // event) that the scheduler can never place a task over — e.g. breakfast
  // 7:00-7:30. When not locked, startMinute/endMinute are null and the
  // bullet is just a preference the AI weighs, not a fixed block.
  locked      Boolean  @default(false)
  startMinute Int?
  endMinute   Int?
  // A non-negotiable that happens every day but isn't pinned to one exact
  // time, e.g. "15 min reading" sometime 9-11pm, or "afternoon walk"
  // sometime noon-5pm. The scheduler places it wherever it fits inside
  // [windowStartMinute, windowEndMinute] each day, ahead of flexible tasks —
  // it's guaranteed to happen, tasks work around it, not the reverse.
  // Mutually exclusive with locked.
  windowed          Boolean @default(false)
  durationMinutes   Int?
  windowStartMinute Int?
  windowEndMinute   Int?
  // Which days a locked or windowed non-negotiable applies on: 0 = Sunday
  // ... 6 = Saturday. Defaults to every day, matching the original
  // always-recurring behavior. A freeform (non-locked, non-windowed)
  // preference ignores this — it's just context text, never day-scoped.
  daysOfWeek        Int[]   @default([0, 1, 2, 3, 4, 5, 6])
  // Unlike a Task's googleEventId (created once, ever), a preference recurs
  // every day and can land at a different time each day (especially a
  // windowed one), so a single event can't represent it. Instead this is
  // the id of the event created *for googleEventDate specifically*; once
  // that date is no longer today, a fresh event gets created for the new
  // day rather than reusing this one.
  googleEventId     String?
  googleEventDate   String?
  // Non-negotiables (locked or windowed) show up in the Today board's Daily
  // column and can be checked off like a task. Recurs every day, so this
  // just holds the day it was last marked done for — compared against
  // "today" the same way googleEventDate is, it resets itself each new day
  // with no cron needed.
  completedDate String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
