# Postgres connection string. Locally you can point this at a free Neon/
# Supabase database. On Vercel, connect a Postgres integration from the
# project's Storage tab — note that marketplace integrations (Neon, etc.)
# prefix every var they create with the storage resource's name, so you'll
# likely get STORE_DATABASE_URL rather than a plain DATABASE_URL. The schema
# reads STORE_DATABASE_URL to match; rename this locally to match whatever
# your Vercel project actually uses if you reconnect a different database.
STORE_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (unpooled) connection, used only for schema changes (`prisma db
# push`, run at build time) — see the `directUrl` comment in
# prisma/schema.prisma for why this needs to be separate from the pooled
# STORE_DATABASE_URL above. Neon's Vercel integration provides this
# automatically as STORE_DATABASE_URL_UNPOOLED; for a different provider,
# point this at that provider's direct/non-pooling connection string (same
# value as STORE_DATABASE_URL is fine if your database isn't pooled at all).
STORE_DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google Calendar OAuth. Create credentials at console.cloud.google.com and
# set GOOGLE_REDIRECT_URI to <your app's base URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Real AI time-blocking: Claude reasons about realistic task durations,
# spacing, and break placement instead of the keyword-heuristic fallback in
# lib/timeBlocks.ts. Get a key at console.anthropic.com. Leave blank to use
# the heuristic scheduler instead — the app still works without this.
ANTHROPIC_API_KEY=

# Shared secret for POST /api/import (e.g. an Apple Shortcut importing tasks
# from a note). Generate any random string and use the same one in the
# Shortcut's request header. Leave blank to disable the endpoint entirely.
IMPORT_SECRET=
